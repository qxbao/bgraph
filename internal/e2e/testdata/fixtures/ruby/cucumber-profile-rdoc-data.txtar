A Cucumber profile can load Ruby documentation as data from a sibling Ruby project.
-- base/service/Gemfile --
source "https://rubygems.org"
gem "cucumber"
-- base/service/cucumber.yml --
default: --require features features
-- base/service/features/orders.feature --
Feature: Orders
  Scenario: Open an order
    Given order data
-- base/service/features/step_definitions/orders.rb --
Given("order data") do
  raise "invalid order" unless File.read(ENV.fetch("ORDER_FIXTURE")).chomp == "first"
end
-- base/shared/Gemfile --
source "https://rubygems.org"
-- base/shared/order.rdoc --
first
-- head/shared/order.rdoc --
second
-- want --
scope graph
select <rb-all-cucumber:service>
