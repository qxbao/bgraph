A widget test reading a file in the host directory keeps its direct dependency.
-- base/pubspec.yaml --
name: app
dependencies:
  flutter:
    sdk: flutter
dev_dependencies:
  integration_test:
    sdk: flutter
-- base/lib/main.dart --
void main() {}
-- base/integration_test/app_test.dart --
import 'package:integration_test/integration_test.dart';
import 'package:app/main.dart' as app;
void main() { IntegrationTestWidgetsFlutterBinding.ensureInitialized(); app.main(); }
-- base/test/manifest_test.dart --
import 'dart:io';
import 'package:flutter_test/flutter_test.dart';
void main() => test('manifest', () => File('web/index.html').readAsStringSync());
-- base/test/widget_test.dart --
void main() {}
-- base/web/index.html --
<html></html>
-- head/web/index.html --
<html><body></body></html>
-- want --
select integration_test/app_test.dart
select test/manifest_test.dart
noselect test/widget_test.dart
scope graph
nowiden unreferenced_file
