An Android host source change selects both the Flutter integration test and the Gradle app unit.
-- base/pubspec.yaml --
name: app
environment:
  sdk: ^3.5.0
dependencies:
  flutter:
    sdk: flutter
dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
-- base/lib/main.dart --
void main() {}
-- base/test/widget_test.dart --
import 'package:flutter_test/flutter_test.dart';
import 'package:app/main.dart';
void main() => testWidgets('w', (t) async {});
-- base/integration_test/app_test.dart --
import 'package:integration_test/integration_test.dart';
import 'package:app/main.dart' as app;
void main() { app.main(); }
-- base/android/settings.gradle --
include ':app'
-- base/android/build.gradle --
allprojects {}
-- base/android/app/build.gradle --
apply plugin: 'com.android.application'
-- base/android/app/src/main/kotlin/MainActivity.kt --
class MainActivity
-- base/other/pubspec.yaml --
name: other
environment:
  sdk: ^3.5.0
dependencies:
  flutter:
    sdk: flutter
dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
-- base/other/test/o_test.dart --
import 'package:flutter_test/flutter_test.dart';
void main() => test('o', () {});
-- head/android/app/src/main/kotlin/MainActivity.kt --
class MainActivity { }
-- want --
select integration_test/app_test.dart
select gradle:android:app
noselect test/widget_test.dart
noselect other/test/o_test.dart
scope graph
nowiden unknown_import
